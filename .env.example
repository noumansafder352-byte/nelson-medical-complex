# Copy this file to `.env.local` for local development, and set the same
# variables in your build environment (e.g. Vercel project settings) for
# production. All values below are PUBLIC: they are embedded in the static
# HTML/JS at build time. Never put secrets or API keys here.

# Production domain, without a trailing slash. Used for canonical URLs,
# Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Form submission endpoints (e.g. Formspree: https://formspree.io/f/xxxxxxxx).
# Leave empty to show the "online submissions are not available yet" notice.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_APPOINTMENT_FORM_ENDPOINT=
